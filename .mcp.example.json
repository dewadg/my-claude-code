{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_API_URL": "https://gitlab.com/api/v4",
        "GITLAB_READ_ONLY_MODE": "false",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PAT}"
      }
    },
    "goland": {
      "type": "http",
      "url": "http://127.0.0.1:64422/stream",
      "headers": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "figma": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp@v0.11.0",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      }
    },
    "mobile-device": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@srmorete/mobile-device-mcp@latest"
      ],
      "env": {
        "MDMS_PORT_ANDROID": "18000",
        "MDMS_PORT_IOS": "19000"
      }
    }
  }
}
